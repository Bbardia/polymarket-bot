# Health-alert mail settings for scripts/live_health_check.py.
# Copy to /home/rasbardi/polymarket-bot/.env.alerts, fill in, then: chmod 600 .env.alerts
# This file is separate from .env (wallet secrets) and .env.live (trading profile).

# Resend API key (https://resend.com/api-keys); sending-only permission is enough.
RESEND_API_KEY=

# Sender on the verified Resend domain.
ALERT_FROM=Polymarket Bot <bot@bardia-amiryavari.ch>

# Recipient(s), comma-separated.
ALERT_TO=

# The stale-cycle threshold (2x V3_LIVE_SCAN_INTERVAL_SECONDS, default 300) is read
# by name from the live profile .env.live (--live-env-file), not from this file.
