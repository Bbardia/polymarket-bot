# REAL-MONEY live profile for run_v3.py live-run (no secrets; wallet keys come from --secrets-file).
# Copy to .env.live (ignored by git), chmod 600, and fill the wallet values
# yourself. `run_v3.py live-shadow` reads this file; it never builds the
# order-signing client and never submits, cancels or redeems anything.

# Shadow refuses to start unless these stay paper/live-blocked.
PAPER_TRADING=false
ENABLE_V3_LIVE_TRADING=true
V3_LIVE_CONFIRMATION=I_UNDERSTAND_REAL_MONEY

# Read-only account snapshot (balance, positions, open orders, trade history).
# Set true only after filling the two wallet values below.
ENABLE_V3_ACCOUNT_READS=true
# Condition IDs of manual positions the bot must treat as external.
POLY_EXTERNAL_CONDITION_IDS=

# User-selected hard limits (pUSD).
V3_MAX_CAPITAL=100
V3_MAX_ORDER_NOTIONAL=2
V3_RESERVE_FRACTION=0.25
V3_MAX_DAILY_LOSS=10
V3_MAX_DRAWDOWN_AMOUNT=10

# Shadow runtime.
V3_LIVE_DATA_DIR=data/live-v7
V3_LIVE_SEED_DIR=/home/rasbardi/polymarket-bot/data/v7-main-paper-20260912
V3_LIVE_SCAN_INTERVAL_SECONDS=300
V3_LIVE_ORDER_TTL_SECONDS=900
V3_LIVE_MAX_ORDER_TTL_SECONDS=1800
V3_LIVE_MAX_QUOTE_AGE_SECONDS=300
V3_LIVE_MAX_OPEN_ORDERS=5
V3_LIVE_MAX_POSITIONS=15
V3_LIVE_MAX_NEW_ORDERS_PER_CYCLE=3

# V7 main weather policy (same names as the paper profile).
V3_PAPER_WEATHER_ENABLED=true
V3_PAPER_WEATHER_MARKET_LIMIT=100
V3_PAPER_WEATHER_MAX_ORDER_NOTIONAL=5
V3_PAPER_WEATHER_KELLY_SIZING_ENABLED=true
V3_PAPER_WEATHER_FRACTIONAL_KELLY=0.05
V3_PAPER_WEATHER_MIN_PROVIDER_COUNT=2
V3_PAPER_WEATHER_REQUIRE_HEALTHY_FORECAST=true
V3_PAPER_WEATHER_OBSERVATIONS_ENABLED=true
V3_PAPER_OPEN_METEO_MAX_REQUESTS_PER_DAY=96
V3_PAPER_OPEN_METEO_CACHE_SECONDS=86400
