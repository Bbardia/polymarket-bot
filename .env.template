# Polymarket Bot V3 environment template
# Copy to .env. Keep the real file local and mode 600.

# V3 is paper-only by default. All three live settings must be changed
# deliberately before the live-capable client can be constructed.
# Authenticated account reads have a separate gate so reconciliation can run
# while paper mode remains true and live-order authorization stays blocked.
ENABLE_V3_ACCOUNT_READS=false
ENABLE_V3_LIVE_TRADING=false
PAPER_TRADING=true
V3_LIVE_CONFIRMATION=

# Dedicated trading signer and Polymarket wallet. Never commit real values.
POLY_PRIVATE_KEY=replace_me_with_local_private_key
POLY_FUNDER_ADDRESS=replace_me_with_local_funder_address

# Optional builder credentials for unified-SDK gasless wallet actions.
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=

# Hard account-level limits. These cap real account cash rather than merely
# labeling a CLI budget.
V3_MAX_CAPITAL=50
V3_MAX_ORDER_NOTIONAL=2
V3_RESERVE_FRACTION=0.25

# Public-data-only paper worker. This cap is deliberately separate from the
# future live-order cap; changing it never authorizes authenticated execution.
V3_PAPER_DATA_DIR=data/v3-paper
V3_PAPER_SCAN_INTERVAL_SECONDS=300
V3_PAPER_MARKET_LIMIT=25
V3_PAPER_DISCOVERY_MAX_MARKETS=2000
V3_PAPER_MIN_LIQUIDITY=1000
V3_PAPER_MIN_NET_RETURN=0.005
V3_PAPER_MAX_ORDER_NOTIONAL=5
V3_PAPER_MAX_OPEN_POSITIONS=20
V3_PAPER_COMPLETE_SET_ENABLED=true
V3_PAPER_OPEN_METEO_MAX_REQUESTS_PER_DAY=24
V3_PAPER_OPEN_METEO_CACHE_SECONDS=21600
V3_PAPER_EARLY_EXIT_ENABLED=false
V3_PAPER_EARLY_EXIT_TARGET_RETURN=0.25
V3_PAPER_EARLY_EXIT_MIN_PROFIT=0.10

# Public-only resolver-aware weather research. Open-Meteo, MET Norway, NWS, and
# JMA supply forecasts where covered; verified-station NOAA METAR observations
# are required for same-day paper entries. Maker and complete-event baskets are
# telemetry only.
V3_PAPER_WEATHER_ENABLED=true
V3_PAPER_WEATHER_HORIZON_DAYS=3
V3_PAPER_WEATHER_DISCOVERY_LIMIT=1500
V3_PAPER_WEATHER_MARKET_LIMIT=100
V3_PAPER_WEATHER_MIN_LIQUIDITY=1000
V3_PAPER_WEATHER_MIN_PRICE=0.02
V3_PAPER_WEATHER_MAX_PRICE=0.98
V3_PAPER_WEATHER_MAX_ORDER_NOTIONAL=5
V3_PAPER_WEATHER_MAX_OPEN_POSITIONS=20
V3_PAPER_WEATHER_BASE_EDGE=0.03
V3_PAPER_WEATHER_ICC=0.05
V3_PAPER_WEATHER_PRIOR_STRENGTH=10
V3_PAPER_WEATHER_FRACTIONAL_KELLY=0.05
V3_PAPER_WEATHER_UNCERTAINTY_Z=1
V3_PAPER_WEATHER_OBSERVATIONS_ENABLED=true

# Comma-separated condition IDs for manual positions that V3 may observe but
# must never manage. Keep real IDs only in the ignored local .env.
POLY_EXTERNAL_CONDITION_IDS=

# Legacy API hosts remain for read-only compatibility only.
POLY_CLOB_HOST=https://clob.polymarket.com
POLY_GAMMA_HOST=https://gamma-api.polymarket.com
POLY_CHAIN_ID=137
LOG_LEVEL=INFO
