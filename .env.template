# Polymarket Bot environment template
# Copy this file to `.env` and fill values locally.
# `.env` is intentionally gitignored. Never commit private keys, API keys,
# wallet seed phrases, bearer tokens, or real trading logs/state.

# ---------------------------------------------------------------------------
# Trading safety
# ---------------------------------------------------------------------------
# Default is dry-run/paper mode. Live trading requires BOTH:
#   1) passing `--live` to the CLI, and
#   2) setting ENABLE_LIVE_TRADING=true here.
ENABLE_LIVE_TRADING=false
PAPER_TRADING=true

# ---------------------------------------------------------------------------
# Polymarket authentication (required only for live trading / private CLOB ops)
# ---------------------------------------------------------------------------
# Polygon private key for the trading wallet. Keep local only.
# Example format only: 0x + 64 hex chars. Do not put a real key in public files.
POLY_PRIVATE_KEY=replace_me_with_local_private_key

# Polymarket Safe/proxy wallet/funder address.
# Example format only: 0x + 40 hex chars.
POLY_FUNDER_ADDRESS=replace_me_with_local_funder_address

# Optional signer address, if different from the funder address.
POLY_SIGNER_ADDRESS=

# Signature type: 0 = EOA/browser wallet, 1 = proxy/email wallet.
POLY_SIGNATURE_TYPE=1

# Optional builder API credentials. Leave blank unless you explicitly use them.
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=

# ---------------------------------------------------------------------------
# Public API endpoints
# ---------------------------------------------------------------------------
POLY_CLOB_HOST=https://clob.polymarket.com
POLY_GAMMA_HOST=https://gamma-api.polymarket.com
POLY_CHAIN_ID=137
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# ---------------------------------------------------------------------------
# Risk limits / runtime settings
# ---------------------------------------------------------------------------
MAX_CAPITAL=25
MAX_POSITION_SIZE=2
EDGE_THRESHOLD=0.15
LOG_LEVEL=INFO
