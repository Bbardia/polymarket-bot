# Polymarket Bot V3 environment template
# Copy to .env. Keep the real file local and mode 600.

# V3 is paper-only by default. All three live settings must be changed
# deliberately before the live-capable client can be constructed.
# Authenticated account reads have a separate gate so reconciliation can run
# while paper mode remains true and live-order authorization stays blocked.
ENABLE_V3_ACCOUNT_READS=false
ENABLE_V3_LIVE_TRADING=false
PAPER_TRADING=true
V3_LIVE_CONFIRMATION=

# Dedicated trading signer and Polymarket wallet. Never commit real values.
POLY_PRIVATE_KEY=replace_me_with_local_private_key
POLY_FUNDER_ADDRESS=replace_me_with_local_funder_address

# Optional builder credentials for unified-SDK gasless wallet actions.
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=

# Hard account-level limits. These cap real account cash rather than merely
# labeling a CLI budget.
V3_MAX_CAPITAL=50
V3_MAX_ORDER_NOTIONAL=2
V3_RESERVE_FRACTION=0.25

# Comma-separated condition IDs for manual positions that V3 may observe but
# must never manage. Keep real IDs only in the ignored local .env.
POLY_EXTERNAL_CONDITION_IDS=

# Legacy API hosts remain for read-only compatibility only.
POLY_CLOB_HOST=https://clob.polymarket.com
POLY_GAMMA_HOST=https://gamma-api.polymarket.com
POLY_CHAIN_ID=137
LOG_LEVEL=INFO
